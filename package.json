{
  "name": "dbeditor",
  "version": "0.1.0",
  "description": "A small web-based database editor for MySQL/MariaDB, PostgreSQL and SQLite.",
  "type": "module",
  "private": true,
  "packageManager": "yarn@4.18.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/bundle.mjs",
    "start": "node dist/dbeditor.mjs",
    "test": "node --test --disable-warning=ExperimentalWarning \"test/*.test.js\""
  },
  "dependencies": {
    "mysql2": "^3.24.6",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.5",
    "vite-plugin-singlefile": "^2.3.4",
    "vue": "^3.5.44"
  }
}
